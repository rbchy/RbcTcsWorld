# Local overrides for development. Copy to .env (never committed) and change what you need:
#   cp .env.example .env
# docker compose reads .env by itself; the backend started from Eclipse or "mvn spring-boot:run" reads the
# same names as environment variables. Every value has a safe development default, so this file is optional.
# The public demo has its own file with real secrets: deploy/.env.example.

# --- security (development values; the 'prod' profile and DEMO_MODE refuse these defaults) ---
JWT_SECRET=change-this-development-secret-key-which-must-be-long-enough-123456789
ADMIN_EMAIL=admin@rbctcsworld.com
ADMIN_PASSWORD=Admin@12345

# --- database (docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce

# --- login lockout: memory (one backend) | redis (shared by every backend instance) ---
LOGIN_STORE=redis
REDIS_URL=redis://localhost:6379

# --- payments: mock (test cards 4242..., default) | stripe (test keys only outside 'prod') ---
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...           # turns on Stripe Elements: the card goes to Stripe, never to this server
# STRIPE_WEBHOOK_SECRET=whsec_...               # from `stripe listen` or the Dashboard: payment results by webhook
# TAX_PROVIDER=stripe                             # Stripe Tax: the right rate per delivery address (default flat 6 %)
# SHIPPING_PROVIDER=shippo                       # real labels through Shippo (default: simulated tracking numbers)
# SHIPPO_TOKEN=shippo_test_...                  # Shippo > Settings > API: the TEST token (labels are free)
# SHIPPO_WEBHOOK_TOKEN=a-long-random-secret     # Shippo webhook URL: https://<host>/api/shipping/shippo/webhook?token=<this>
# SHIP_FROM_STREET=...  SHIP_FROM_CITY=...  SHIP_FROM_STATE=..  SHIP_FROM_ZIP=.....   # return address on labels
# STRIPE_API_BASE=http://localhost:12111        # stripe-mock

# --- order e-mails: log (console) | smtp (Mailpit on http://localhost:8025) | ses (Amazon SES) ---
NOTIFICATIONS_CHANNEL=log
MAIL_HOST=localhost
MAIL_PORT=1025
# MAIL_FROM=RbcTcsWorld Shop <orders@your-store-domain.com>   # the store's own domain, verified in SES
# SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...                     # IAM user allowed only ses:SendEmail
# AWS_SECRET_ACCESS_KEY=...
# SES_CONFIGURATION_SET=rbctcsworld-events      # sends bounces and complaints to SNS
# SES_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:rbctcsworld-ses-events

# --- other ---
API_DOCS_ENABLED=true        # /v3/api-docs for OWASP ZAP
DEMO_MODE=false              # true only on the public demo (deploy/)
