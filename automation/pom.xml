<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.rbctcsworld</groupId>
  <artifactId>ecommerce-automation</artifactId>
  <version>1.0.0</version>

  <!--
    Black-box automation against a RUNNING backend (default http://localhost:8081).
    Run all:        mvn test                    (everything except the phone tests)
    API only:       mvn test -Dgroups=api
    Without UI:     mvn test -DexcludedGroups=ui,mobile
    Phones:         mvn test -Dgroups=mobile -DexcludedGroups=none -Dbrowser=android-chrome|ios-safari  (Appium)
    DB checks:      mvn test -Dgroups=db        (needs PostgreSQL from docker compose)
    Other server:   mvn test -DbaseUrl=http://host:8081 -DuiUrl=http://host:5173

    Allure report (after a test run):
                    mvn allure:serve     -> builds the report and opens it in the browser
                    mvn allure:report    -> static report in target/allure-report
  -->

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.0</junit.version>
    <junit.platform.version>1.11.0</junit.platform.version>
    <cucumber.version>7.18.0</cucumber.version>
    <selenium.version>4.49.0</selenium.version>
    <!-- phone tests need Appium; run them with -Dgroups=mobile -DexcludedGroups=none (docs/modules/APPIUM_MOBILE_BN.md) -->
    <excludedGroups>mobile</excludedGroups>
    <restassured.version>5.5.0</restassured.version>
    <jackson.version>2.21.7</jackson.version>
    <postgresql.version>42.7.13</postgresql.version>
    <allure.version>2.29.1</allure.version>
    <axe.version>4.11.3</axe.version>
    <allure.report.version>2.29.0</allure.report.version>
    <!-- shown on the Allure "Environment" widget; override with -DbaseUrl=... -->
    <baseUrl>http://localhost:8081</baseUrl>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-bom</artifactId>
        <version>${allure.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Transitive versions raised for known vulnerabilities (DEF-021, found by the SBOM-based OSV scan) -->
      <!-- allure-rest-assured -> allure-attachments: FreeMarker template path traversal, CVSS 9.1 (GHSA-27j2-h3m2-8237) -->
      <dependency><groupId>org.freemarker</groupId><artifactId>freemarker</artifactId><version>2.3.35</version></dependency>
      <!-- json-schema-validator -> json-schema-core: Rhino, CVSS 2.7 (GHSA-3w8q-xq97-5j7x); 1.7.x line stays API compatible -->
      <dependency><groupId>org.mozilla</groupId><artifactId>rhino</artifactId><version>1.7.15.1</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-suite</artifactId><version>${junit.platform.version}</version><scope>test</scope></dependency>
    <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><version>${restassured.version}</version><scope>test</scope></dependency>
    <!-- API contract tests: responses validated against JSON Schemas in src/test/resources/contracts -->
    <dependency><groupId>io.rest-assured</groupId><artifactId>json-schema-validator</artifactId><version>${restassured.version}</version><scope>test</scope></dependency>
    <!-- lets REST Assured serialize Map/record request bodies to JSON -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${jackson.version}</version><scope>test</scope></dependency>
    <!-- JDBC driver for database validation tests (@Tag("db")) -->
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>${postgresql.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.seleniumhq.selenium</groupId><artifactId>selenium-java</artifactId><version>${selenium.version}</version><scope>test</scope></dependency>
    <!-- Accessibility: Deque axe-core rules (WCAG 2.1 A/AA) run inside the Selenium browser -->
    <dependency><groupId>com.deque.html.axe-core</groupId><artifactId>selenium</artifactId><version>${axe.version}</version><scope>test</scope>
      <!-- WebDriverManager is not used (Selenium Manager provides the drivers) and brought httpclient5/httpcore5
           with known vulnerabilities (CVSS up to 7.5) into the test classpath -->
      <exclusions><exclusion><groupId>io.github.bonigarcia</groupId><artifactId>webdrivermanager</artifactId></exclusion></exclusions>
    </dependency>
    <dependency><groupId>io.cucumber</groupId><artifactId>cucumber-java</artifactId><version>${cucumber.version}</version><scope>test</scope></dependency>
    <dependency><groupId>io.cucumber</groupId><artifactId>cucumber-junit-platform-engine</artifactId><version>${cucumber.version}</version><scope>test</scope></dependency>
    <!-- dependency injection: share ScenarioContext between step classes -->
    <dependency><groupId>io.cucumber</groupId><artifactId>cucumber-picocontainer</artifactId><version>${cucumber.version}</version><scope>test</scope></dependency>
    <!-- Allure: JUnit 5 tests, Cucumber scenarios (with Gherkin steps) and every HTTP request/response -->
    <dependency><groupId>io.qameta.allure</groupId><artifactId>allure-junit5</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.qameta.allure</groupId><artifactId>allure-cucumber7-jvm</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.qameta.allure</groupId><artifactId>allure-rest-assured</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <systemPropertyVariables>
            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Copies categories.json + environment.properties into allure-results before the tests run -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>allure-metadata</id>
            <phase>process-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/allure-results</outputDirectory>
              <resources>
                <resource>
                  <directory>src/test/allure</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>2.15.2</version>
        <configuration>
          <reportVersion>${allure.report.version}</reportVersion>
          <resultsDirectory>allure-results</resultsDirectory>
          <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
