{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Auth result",
  "description": "POST /api/auth/register, /api/auth/login and /api/auth/refresh",
  "type": "object",
  "required": [
    "token",
    "email",
    "role",
    "refreshToken",
    "expiresIn"
  ],
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "CUSTOMER",
        "ADMIN"
      ]
    },
    "refreshToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "opaque, 256 random bits, base64url; rotated on every refresh"
    },
    "expiresIn": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600,
      "description": "access token lifetime in seconds"
    },
    "guest": {
      "type": "boolean"
    }
  }
}
