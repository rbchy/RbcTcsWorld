<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion><parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/></parent>
<groupId>com.rbctcsworld</groupId><artifactId>rbctcsworld-shop-backend</artifactId><version>1.0.0</version><properties><java.version>21</java.version><jjwt.version>0.12.6</jjwt.version>
<!-- Spring Boot 4.1 (Spring Framework 7, Tomcat 11, Jackson 3, Hibernate 7) is in open-source support.
     Patch releases newer than the ones Boot 4.1.1 manages, pinned on the SAME release line because OSV-Scanner
     found advisories in the managed versions (Tomcat CVSS 9.8, Jackson 7.5). Remove a pin when Boot ships it. -->
<tomcat.version>11.0.26</tomcat.version>
<jackson-bom.version>3.1.7</jackson-bom.version>
<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
<postgresql.version>42.7.14</postgresql.version>
<!-- coverage gate: measured 96.3 % lines / 78.8 % branches (Oct 2026); set just below, raise it as tests are added, never lower it -->
<jacoco.minimum.line>0.97</jacoco.minimum.line>
<jacoco.minimum.branch>0.88</jacoco.minimum.branch>
<!-- PIT mutation testing (profile "mutation"): minimum mutation score in %, ratchet only upwards -->
<pitest.version>1.30.0</pitest.version>
<pitest.mutationThreshold>84</pitest.mutationThreshold>
</properties>
<dependencies>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
<dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-flyway</artifactId></dependency><dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
<dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>${jjwt.version}</version></dependency><dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency><dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency>
<!-- OpenAPI description of the API at /v3/api-docs (no UI): used by the OWASP ZAP API scan in CI -->
<dependency><groupId>org.eclipse.angus</groupId><artifactId>angus-mail</artifactId></dependency><!-- Jakarta Mail for the order e-mails; version from the Spring Boot BOM -->
<dependency><groupId>io.lettuce</groupId><artifactId>lettuce-core</artifactId></dependency><!-- login lockout shared in Redis; version from the Spring Boot BOM -->
<dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-api</artifactId><version>3.0.3</version></dependency>
<!-- Spring Boot 4 test starters are per technology: MockMvc (@AutoConfigureMockMvc) has its own -->
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>
<!-- In-memory database (PostgreSQL mode) so backend tests run without Docker -->
<!-- JUnit Platform launcher: needed by the PIT JUnit 5 plugin to discover and run the tests -->
<dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId><scope>test</scope></dependency>
<dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
<dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><scope>test</scope></dependency><!-- real Redis in RedisLoginLockoutIntegrationTest -->
</dependencies><build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
<!-- JaCoCo code coverage: agent during tests, HTML/XML/CSV report and a minimum gate in "mvn verify" -->
<plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.14</version>
<configuration><excludes><exclude>com/rbctcsworld/ecommerce/EcommerceApplication.class</exclude></excludes></configuration>
<executions>
<execution><id>prepare-agent</id><goals><goal>prepare-agent</goal></goals>
<!-- Mockito generates mock classes at runtime: never instrument them (noise on newer JDKs) -->
<configuration><excludes><exclude>**/*$MockitoMock$*</exclude></excludes></configuration></execution>
<execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
<execution><id>check</id><phase>verify</phase><goals><goal>check</goal></goals>
<configuration><rules><rule><element>BUNDLE</element><limits>
<limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${jacoco.minimum.line}</minimum></limit>
<limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${jacoco.minimum.branch}</minimum></limit>
</limits></rule></rules></configuration></execution>
</executions></plugin>
</plugins></build>
<!-- Mutation testing: mvn -Pmutation -Djacoco.skip=true test-compile pitest:mutationCoverage
     PIT changes the business code in small ways (">" becomes ">=", a return value becomes null, a call is removed ...)
     and re-runs the unit tests. A mutant that no test notices "survives": the tests run that code but do not check it. -->
<profiles><profile><id>mutation</id><build><plugins>
<plugin><groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>${pitest.version}</version>
<dependencies><dependency><groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>1.2.3</version></dependency></dependencies>
<configuration>
<!-- business logic only: services, the order state machine, return policy, coupon rules, payment gateway -->
<targetClasses>
<param>com.rbctcsworld.ecommerce.*.*Service</param>
<param>com.rbctcsworld.ecommerce.order.OrderStatus</param>
<param>com.rbctcsworld.ecommerce.order.CustomerOrder</param>
<param>com.rbctcsworld.ecommerce.returns.ReturnPolicy</param>
<param>com.rbctcsworld.ecommerce.coupon.Coupon</param>
<param>com.rbctcsworld.ecommerce.payment.MockPaymentGateway</param>
<param>com.rbctcsworld.ecommerce.auth.InMemoryLoginAttemptStore</param>
<param>com.rbctcsworld.ecommerce.auth.RedisLoginAttemptStore</param>
<param>com.rbctcsworld.ecommerce.payment.StripePaymentGateway</param>
<param>com.rbctcsworld.ecommerce.notification.NotificationDeliveryService</param>
<param>com.rbctcsworld.ecommerce.audit.AuditChain</param>
<param>com.rbctcsworld.ecommerce.audit.AuditChange</param>
<param>com.rbctcsworld.ecommerce.common.Csv</param>
</targetClasses>
<!-- fast unit tests only; the Spring integration tests would make every mutant start a Spring context -->
<targetTests><param>com.rbctcsworld.ecommerce.*.*Test</param></targetTests>
<excludedTestClasses><param>com.rbctcsworld.ecommerce.integration.*</param></excludedTestClasses>
<mutators><mutator>DEFAULTS</mutator></mutators>
<threads>4</threads>
<timestampedReports>false</timestampedReports>
<outputFormats><param>HTML</param><param>XML</param></outputFormats>
<parseSurefireArgLine>false</parseSurefireArgLine>
<mutationThreshold>${pitest.mutationThreshold}</mutationThreshold>
</configuration></plugin>
</plugins></build></profile></profiles>
</project>
