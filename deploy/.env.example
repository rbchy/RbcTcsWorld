# Copy to deploy/.env and fill in (deploy/setup-vm.sh writes it for you with random values).
# Never commit deploy/.env: it is in .gitignore.

# Address of the demo. Own domain (DNS A record -> server IP) or the free sslip.io name of the IP:
#   server IP 129.146.10.20  ->  DEMO_DOMAIN=129-146-10-20.sslip.io
DEMO_DOMAIN=

# Long random values without special characters, e.g.  openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
# Store admin of the demo. Keep it to yourself: it can change every product.
ADMIN_EMAIL=admin@rbctcsworld.com
ADMIN_PASSWORD=
