# HTTPS in front of the storefront. Caddy gets and renews the Let's Encrypt certificate by itself and
# redirects http:// to https://. DEMO_DOMAIN: your own domain, or <ip-with-dashes>.sslip.io (free, no setup).
{$DEMO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# a public demo gets visitors and bots: keep request bodies small (the API never needs more)
	request_body {
		max_size 1MB
	}

	reverse_proxy frontend:80
}
