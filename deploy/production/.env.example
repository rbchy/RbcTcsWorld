# The live store's settings. setup-prod.sh writes deploy/production/.env from this file with random secrets;
# fill in the rest by hand (nano deploy/production/.env). Only the owner may read it (chmod 600).
# Guide (Bangla): docs/deploy/PRODUCTION_BN.md

# --- the address -------------------------------------------------------------------------------------------
STORE_DOMAIN=your-store.com          # DNS A record -> this server's IP (and www.your-store.com, optional)

# --- secrets (setup-prod.sh generates them) --------------------------------------------------------------------
DB_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=owner@your-store.com
ADMIN_PASSWORD=

# --- payments, tax, shipping, e-mail (switch on one by one, test mode first) ----------------------------------
PAYMENT_PROVIDER=mock                # stripe once the Stripe account is verified (live keys work only here)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
TAX_PROVIDER=flat                    # stripe after the sales tax license (docs/modules/STRIPE_TAX_BN.md)
SHIPPING_PROVIDER=simulated          # shippo with a Shippo account (docs/modules/SHIPPO_SHIPPING_BN.md)
# SHIPPO_TOKEN=shippo_live_...
# SHIPPO_WEBHOOK_TOKEN=
# SHIP_FROM_STREET=...  SHIP_FROM_CITY=...  SHIP_FROM_STATE=PA  SHIP_FROM_ZIP=.....  SHIP_FROM_PHONE=...
NOTIFICATIONS_CHANNEL=log            # ses once the domain is verified in SES (docs/modules/AMAZON_SES_MAIL_BN.md)
# MAIL_FROM=RbcTcsWorld Shop <orders@your-store.com>
# SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=  SES_CONFIGURATION_SET=  SES_SNS_TOPIC_ARN=

# --- the business (policy pages) ----------------------------------------------------------------------------------
# STORE_LEGAL_NAME=RbcTcsWorld LLC  STORE_STREET=...  STORE_CITY=...  STORE_STATE=PA  STORE_ZIP=.....
# STORE_CONTACT_EMAIL=support@your-store.com  STORE_POLICIES_REVIEWED=true
# contact form (ADR-0018): messages go to STORE_CONTACT_EMAIL (else ADMIN_EMAIL); the form promises an answer within
# STORE_REPLY_DAYS business days (default 2)
# STORE_REPLY_DAYS=2

# --- backups ----------------------------------------------------------------------------------------------------
BACKUP_PASSPHRASE=                   # generated; ALSO keep a copy outside the server (password manager): without it no backup can be read
BACKUP_DIR=/home/ubuntu/backups
BACKUP_KEEP_DAYS=14
# off the server: any S3-compatible bucket (Oracle Object Storage has an S3 endpoint; AWS S3; Backblaze B2)
# BACKUP_S3_BUCKET=rbctcsworld-backups
# BACKUP_S3_PREFIX=rbctcsworld
# BACKUP_S3_ENDPOINT=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com   (empty for AWS S3)
# BACKUP_S3_REGION=us-ashburn-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# --- alerts -----------------------------------------------------------------------------------------------------
# ALERT_WEBHOOK_URL=https://ntfy.sh/<a-long-random-topic>   (ntfy phone app; or a Slack / Discord webhook)
