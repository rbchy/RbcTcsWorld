# HTTPS in front of the live store. Caddy gets and renews the Let's Encrypt certificate for STORE_DOMAIN and
# redirects http:// to https://. "www." is sent to the bare domain.
{$STORE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# 1 MB is plenty for the API; product photo uploads (ADR-0017, admin only) may be up to 10 MB
	@photoUpload path /api/products/pictures
	request_body @photoUpload {
		max_size 11MB
	}
	@notPhotoUpload not path /api/products/pictures
	request_body @notPhotoUpload {
		max_size 1MB
	}

	reverse_proxy frontend:80
}

www.{$STORE_DOMAIN} {
	redir https://{$STORE_DOMAIN}{uri} permanent
}
